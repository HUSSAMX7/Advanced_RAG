# First feature: optional email sign-in. These are project public values.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Private original document storage. Server-side only; never use a VITE_ prefix.
RAG_SUPABASE_URL=
RAG_SUPABASE_SECRET_KEY=
RAG_SUPABASE_BUCKET=documents
RAG_SUPABASE_TIMEOUT_SECONDS=30
RAG_MAX_UPLOAD_BYTES=20971520

# Required for portable encrypted settings (Linux/containers/multiple hosts).
# Generate privately with: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep this key outside source control and preserve it across deployments.
WEB_CREDENTIAL_ENCRYPTION_KEY=

WEB_IDENTITY_ENABLED=true
WEB_DATA_DIR=storage/library
GUEST_SESSION_SECONDS=900
GUEST_RENEWAL_GRACE_SECONDS=60
GUEST_CLOSE_GRACE_SECONDS=15

# The CLI may use these keys. Web accounts and guests supply their own in Settings.
OPENAI_API_KEY=
LLAMA_PARSE_API_KEY=
PDF_PROVIDER=llamaparse
