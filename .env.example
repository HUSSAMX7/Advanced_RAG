PDF_PROVIDER=llamaparse
LLAMA_PARSE_API_KEY=
OPENAI_API_KEY=
LIGHTONOCR_URL=http://localhost:8000/v1/chat/completions
LIGHTONOCR_MODEL=lightonai/LightOnOCR-2-1B
LIGHTONOCR_DPI=200
LIGHTONOCR_CONCURRENCY=64
LIGHTONOCR_MAX_TOKENS=4096
LIGHTONOCR_TIMEOUT_SECONDS=300
LIGHTONOCR_POSTPROCESS=true
FAISS_PERSIST_DIR=storage/pdf_documents
EMBEDDING_MODEL=text-embedding-3-small
AGENT_MODEL=gpt-4o-mini
RERANK_MODEL=gpt-4o-mini
RETRIEVAL_CANDIDATES=20
RETRIEVAL_TOP_K=5
CHAT_SESSIONS_DIR=chat_sessions
WEB_DATA_DIR=storage/library
MAX_UPLOAD_BYTES=52428800
# Optional custom path; detected automatically in standard Windows installations.
LIBREOFFICE_PATH=
